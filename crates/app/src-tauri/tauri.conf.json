{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupportOS++",
  "identifier": "com.supportos.plusplus",
  "build": {
    "beforeDevCommand": "cargo run -p supportos-plusplus-xtask --bin xtask -- trunk-serve",
    "beforeBuildCommand": "cargo run -p supportos-plusplus-xtask --bin xtask -- trunk-build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SupportOS++",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "kimpearce888",
    "category": "Productivity",
    "shortDescription": "Local-first AI-powered support operating system for Help Scout",
    "longDescription": "SupportOS++ is an independent, open-source Rust/Tauri desktop reimplementation of supportos. Local-first: no telemetry, no cloud AI, no data egress.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3",
          "libgtk-3-0",
          "libglib2.0-0t64",
          "libcairo2",
          "libpango-1.0-0",
          "libgdk-pixbuf-2.0-0",
          "libatk1.0-0t64",
          "libatk-bridge2.0-0t64",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0",
          "librsvg2-2"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
